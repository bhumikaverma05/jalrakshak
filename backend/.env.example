APP_NAME=JalRakshak API
ENVIRONMENT=development
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://jalrakshak:change-me@localhost:5433/jalrakshak_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT=5

# Reserved for later authentication implementation. Replace before enabling authentication.
SECRET_KEY=replace-with-a-long-random-value
