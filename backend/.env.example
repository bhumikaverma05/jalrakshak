APP_NAME=JalRakshak API
ENVIRONMENT=development
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://jalrakshak:change-me@localhost:5433/jalrakshak_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT=5

# Placeholder only. Replace with a private random value of at least 32 characters.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-private-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REPORT_DUPLICATE_RADIUS_M=100
REPORT_DUPLICATE_WINDOW_HOURS=24
EVIDENCE_STORAGE_DIR=uploads/reports
EVIDENCE_MAX_SIZE_BYTES=10000000
SATELLITE_MNDWI_WATER_THRESHOLD=0.0
SATELLITE_ANALYSIS_PIXEL_SIZE_M=20
